     return cb.raw, expected_field_names(spec, path), path
 
 
+class _SentinelCaptured(Exception):
+    """Raised by the capture stand-in once `run_pass1` has handed over its request."""
+
+
+def sentinel_runtime_messages(spec, codebook_path=None) -> list[dict]:
+    """The message lists `run_pass1` itself builds for the sentinel inputs — attempt 1,
+    then attempt 2 with the sentinel feedback — captured at the name it calls
+    `ollama_chat` by, so no request is made (12w-V1A option C)."""
+    import sys
+    from engine.core.effective_config import SENTINEL_TEXT, stage_config
+    codebook, names, path = _sentinel_codebook(spec, codebook_path)
+    unit_map = build_unit_map(0, SENTINEL_TEXT)
+    cfg = stage_config("elicitation_pass1", spec)
+    feedbacks = [""] + ([sentinel_feedback_block(spec, path)] if MAX_PASS1_ATTEMPTS > 1 else [])
+    sent: list[list[dict]] = []
+
+    def capture(**kw):
+        sent.append(kw["messages"])
+        raise _SentinelCaptured
+
+    module = sys.modules[__name__]
+    real = module.ollama_chat
+    module.ollama_chat = capture
+    try:
+        for feedback in feedbacks:
+            try:
+                run_pass1(unit_map, codebook, names, 0, feedback=feedback, cfg=cfg)
+            except _SentinelCaptured:
+                pass
+    finally:
+        module.ollama_chat = real
+    return [m for attempt in sent for m in attempt]
+
+
 def _names_by_class(codebook: dict, field_names: tuple[str, ...]) -> dict[str, list[str]]:
     grouped = group_by_class(codebook, field_names)
     return {cls: [f["name"] for f in grouped[cls]] for cls in C.CLASSES}
