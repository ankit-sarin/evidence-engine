{
 "$defs": {
  "EvidenceSpan": {
   "description": "A single extracted field with its supporting evidence.",
   "properties": {
    "confidence": {
     "maximum": 1.0,
     "minimum": 0.0,
     "title": "Confidence",
     "type": "number"
    },
    "field_name": {
     "title": "Field Name",
     "type": "string"
    },
    "source_snippet": {
     "description": "Verbatim quote from paper supporting this value (1-3 sentences). Empty string if value is NOT_FOUND.",
     "title": "Source Snippet",
     "type": "string"
    },
    "tier": {
     "maximum": 4,
     "minimum": 1,
     "title": "Tier",
     "type": "integer"
    },
    "value": {
     "title": "Value",
     "type": "string"
    }
   },
   "required": [
    "field_name",
    "value",
    "source_snippet",
    "confidence",
    "tier"
   ],
   "title": "EvidenceSpan",
   "type": "object"
  }
 },
 "description": "Schema used for Ollama structured output (Pass 2 only).",
 "properties": {
  "fields": {
   "items": {
    "$ref": "#/$defs/EvidenceSpan"
   },
   "title": "Fields",
   "type": "array"
  }
 },
 "required": [
  "fields"
 ],
 "title": "ExtractionOutput",
 "type": "object"
}
